{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sixgunretriever",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PRIVATE_MODE": "true" },
  "ratelimits": [{ "name": "PRIVATE_LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
